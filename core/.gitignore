# Build output
/bin/
/dist/
# Windows executables built in the core/ root during dev
/tts-webui.exe
# Linux/macOS binary built in core/ root during dev
/tts-webui

# Vite build output lives in ui/dist (kept in git only as a placeholder).
# The root .gitignore ignores every dist/ directory, so re-include it first.
!/ui/dist/
/ui/dist/*
!/ui/dist/.gitkeep

# Stray test/build executables
*.exe
