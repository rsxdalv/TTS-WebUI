{
  "tabsInGroups": {
    "extensions": [
      {
        "package_name": "tts_webui_extension.bark",
        "name": "Bark",
        "requirements": "git+https://github.com/rsxdalv/tts_webui_extension.bark@main",
        "description": "Bark TTS engine",
        "extension_type": "interface",
        "extension_class": "text-to-speech",
        "author": "rsxdalv",
        "license": "MIT",
        "website": "https://github.com/suno-ai/bark",
        "extension_platform_version": "0.0.1",
        "proxy": "native"
      },
      {
        "package_name": "tts_webui_extension.xtts",
        "name": "XTTS",
        "requirements": "git+https://github.com/rsxdalv/tts_webui_extension.xtts@main",
        "description": "XTTSv2 engine",
        "extension_type": "interface",
        "extension_class": "text-to-speech",
        "author": "rsxdalv",
        "license": "MIT",
        "website": "https://github.com/coqui-ai/TTS",
        "extension_platform_version": "0.0.1"
      },
      {
        "package_name": "tts_webui_extension.custom_engine",
        "name": "Custom Engine",
        "requirements": "git+https://github.com/rsxdalv/tts_webui_extension.custom@main",
        "description": "Engine with explicit manifest block",
        "extension_type": "interface",
        "extension_class": "text-to-speech",
        "author": "rsxdalv",
        "license": "MIT",
        "website": "https://example.com",
        "extension_platform_version": "0.0.1",
        "engine": {
          "kind": "python-venv",
          "install": { "requirements": ["my-package>=1.0"] },
          "launch": { "cmd": ["python", "-m", "myengine"], "port_arg": "--port" },
          "health": { "path": "/health", "interval_s": 2, "timeout_s": 10 },
          "api": { "openai_speech_path": "/v1/audio/speech" },
          "ui": { "gradio_iframe": true },
          "cancel": { "mode": "endpoint", "path": "/cancel" },
          "keep_alive": 300
        }
      }
    ]
  }
}
